import asyncio
import logging
import time
from typing import Any, Optional

logger = logging.getLogger("LLMOrchestrator")

class LLMOrchestrator:
    """
    Голова «Франкенштейна»: оркестратор, управляющий ходом матча.
    Связывает сетевой клиент, базу данных, языковую модель/транслятор и математические движки.
    """
    def __init__(self, client: Any, db: Any, engines: Any, translator: Any):
        self.client = client
        self.db = db
        self.engines = engines
        self.translator = translator

    async def play_match(self, table_id: str) -> None:
        logger.info(f"Запуск игрового цикла за столом {table_id}...")
        
        last_sent_move_count = -1  # Защита от повторной отправки хода на том же ходу
        game_type = "Chess"
        last_state_change_time = time.time()
        
        my_agent_name = "Frank_by_DVB"
        try:
            me_resp = await self.client.client.get("/api/keys/me", headers=self.client._get_auth_headers())
            if me_resp.status_code == 200:
                my_agent_name = me_resp.json().get("agent", my_agent_name)
        except Exception:
            pass

        try:
            while True:
                state = await self.client.get_match_state(table_id)
                
                if not state:
                    await asyncio.sleep(3)
                    continue
                    
                status = state.get("status")
                if status == "waiting_for_opponent":
                    if time.time() - last_state_change_time > 300:
                        logger.warning(f"Таймаут: Никто не присоединился к столу {table_id} за 5 минут.")
                        await self.client.leave_table(table_id)
                        break
                    await asyncio.sleep(5)
                    continue

                # ИГРА ИДЕТ
                game_type = state.get("game_type", state.get("game", game_type))
                moves_history = state.get("moves", [])
                current_moves_len = len(moves_history)
                
                if state.get("is_finished", False) or status in ["finished", "aborted", "abandoned"]:
                    winner = state.get("winner", "Unknown")
                    logger.info(f"Матч {table_id} завершен! Победитель: {winner}")
                    if hasattr(self.db, 'save_match'):
                        await self.db.save_match(table_id, game_type, winner, moves_history)
                    await self.client.leave_table(table_id)
                    break

                # --- ЖЕСТКАЯ ПРОВЕРКА ОЧЕРЕДИ ОТ СЕРВЕРА ---
                # Платформа всегда шлет свой флаг вашей очереди в yourTurn
                is_my_turn = state.get("yourTurn", False)
                
                # Если длина истории изменилась, сбрасываем защиту отправки
                if current_moves_len != last_sent_move_count:
                    last_sent_move_count = -1

                if is_my_turn and last_sent_move_count != current_moves_len:
                    logger.info(f"Очередь нашего хода! Ходов в истории: {current_moves_len}")
                    
                    parsed_move = None
                    if current_moves_len > 0:
                        try:
                            parsed_move = self.translator.parse_move(game_type, moves_history[-1])
                        except Exception:
                            pass
                    
                    bot_move = self._calculate_response_move(game_type, state, parsed_move)
                    
                    if bot_move:
                        logger.info(f"Отправляем ход на сервер: {bot_move}")
                        success = await self.client.send_move(table_id, bot_move)
                        if success:
                            logger.info("Ход успешно отправлен.")
                            last_sent_move_count = current_moves_len  # Запоминаем, что на эту длину истории мы уже сходили
                            last_state_change_time = time.time()
                            await asyncio.sleep(3)
                        else:
                            logger.warning("Сервер отклонил ход. Повтор через 2с...")
                            await asyncio.sleep(2)
                    else:
                        logger.warning("Движок не смог рассчитать ход.")
                else:
                    # Сейчас не наша очередь (или мы уже сделали ход на этот полуход) — просто ждем
                    await asyncio.sleep(2)

                # Таймаут зависания (никто не ходит 5 минут)
                if time.time() - last_state_change_time > 300:
                    logger.warning(f"Таймаут: Игра на столе {table_id} зависла на 5 минут.")
                    await self.client.leave_table(table_id)
                    break
                
        except asyncio.CancelledError:
            logger.info(f"Игровой цикл стола {table_id} отменен.")
        except Exception as e:
            logger.error(f"Критическая ошибка в матче {table_id}: {e}", exc_info=True)
            await self.client.leave_table(table_id)

    def _calculate_response_move(self, game_type: str, board_state: dict, parsed_move: Optional[dict]) -> Optional[str]:
        """Маршрутизация к правильному математическому движку в зависимости от типа игры"""
        game_lower = game_type.lower()
        
        # Шахматы
        if "chess" in game_lower:
            fen = board_state.get("fen")
            legal_moves_list = board_state.get("legal_moves", [])
            
            logger.info(f"Текущий FEN от сервера: {fen}, Доступно легальных ходов: {len(legal_moves_list)}")
            
            # Если у нас есть легальные ходы от сервера, используем Stockfish для выбора лучшего из них,
            # либо просто берем первый легальный ход (что гарантирует 100% принятие сервером).
            if legal_moves_list:
                # Попробуем спросить Stockfish, если есть правильный FEN
                selected_move = None
                if fen:
                    try:
                        raw_move = self.engines.get_chess_move(fen)
                        if raw_move and len(raw_move) >= 4:
                            f_from, f_to = raw_move[0:2], raw_move[2:4]
                            promo = raw_move[4] if len(raw_move) == 5 else None
                            
                            for lm in legal_moves_list:
                                if lm.get("from") == f_from and lm.get("to") == f_to:
                                    if promo and lm.get("promotion") != promo:
                                        continue
                                    selected_move = lm
                                    break
                    except Exception as e:
                        logger.error(f"Ошибка Stockfish: {e}")
                
                # Если Stockfish не смог выбрать или предложил что-то не то, берем первый легальный ход от сервера
                if not selected_move:
                    selected_move = legal_moves_list[0]
                    logger.info(f"Берем гарант-ход из legal_moves: {selected_move}")
                
                if "type" not in selected_move:
                    selected_move["type"] = "move"
                return selected_move
            
        # 2. Быки и коровы (Алгоритм Кнута)
        elif "bulls" in game_lower or "быки" in game_lower:
            history = board_state.get("history", [])
            return self.engines.get_bulls_cows_move(history)
            
        # 3. Морской бой (Probability Grid)
        elif "sea" in game_lower or "морской" in game_lower:
            my_board = board_state.get("my_board", [])
            shots = board_state.get("shots", [])
            return self.engines.get_sea_battle_move(my_board, shots)
            
        # 4. Шашки / Реверси / Гомоку (Минимакс)
        elif any(g in game_lower for g in ["checkers", "shashki", "шашки", "reversi", "gomoku"]):
            board = board_state.get("board", [])
            return self.engines.get_minimax_move(game_type, board)
            
        logger.warning(f"Движок для игры '{game_type}' не найден!")
        return None